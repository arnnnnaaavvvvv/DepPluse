{
  "name": "@arnavvv/deppulse",
  "version": "0.2.0",
  "description": "Universal dependency health and upgrade intelligence CLI and engine (npm, PyPI, Crates, Go, Ruby, PHP, Maven, NuGet)",
  "keywords": [
    "dependency",
    "health",
    "maintenance",
    "upgrade",
    "polyglot",
    "python",
    "rust",
    "golang",
    "npm",
    "crates",
    "pypi",
    "rubygems",
    "packagist",
    "maven",
    "nuget",
    "audit"
  ],
  "author": "Arnav",
  "license": "MIT",
  "type": "module",
  "bin": {
    "deppulse": "bin/deppulse.js"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "vite web --port 5173",
    "build:web": "vite build web",
    "vercel-build": "npm run build:web",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "picocolors": "^1.1.1",
    "semver": "^7.6.3",
    "yaml": "^2.6.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@arnavvv/deppulse": "^0.2.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.9.0",
    "@types/semver": "^7.5.8",
    "eslint": "^10.13.0",
    "prettier": "^3.3.3",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.14.0",
    "vitest": "^5.0.5"
  }
}
